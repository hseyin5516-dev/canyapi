# Medya yuklemeleri klasoru - Yalnizca gorsel dosyalarina izin ver, script calistirmayi engelle
<FilesMatch "\.(php|php5|php7|php8|phtml|pl|py|cgi|sh|bash|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
