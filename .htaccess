# ==============================================================================
# Can Yapı Antalya - Root .htaccess Yapılandırması
# Alan Adı: https://canyapiantalya.com.tr
# ==============================================================================

# UTF-8 Karakter Kodlaması
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .json .xml
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. WWW'yi Non-WWW'ye ve HTTPS'e 301 Kalıcı Yönlendirme
    RewriteCond %{HTTP_HOST} ^www\.canyapiantalya\.com\.tr$ [NC]
    RewriteRule ^(.*)$ https://canyapiantalya.com.tr/$1 [R=301,L]

    # 2. HTTP'den HTTPS'e Zorunlu 301 Yönlendirmesi
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://canyapiantalya.com.tr%{REQUEST_URI} [R=301,L]

    # 3. Doğrudan .html uzantısıyla gelen istekleri Clean URL'e 301 yönlendir
    # (API ve POST istekleri haricinde)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 4. Clean URL isteklerini arka planda .html dosyasına eşle
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ==============================================================================
# GZIP & DEFLATE Sıkıştırma (Hız ve PageSpeed Optimizasyonu)
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# Tarayıcı Önbellekleme (Browser Caching & Expires Headers)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML dosyaları (Hemen güncellenmesi için 1 saat)
    ExpiresByType text/html "access plus 1 hour"

    # CSS ve JavaScript (Minified dosyalar için 1 ay)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Görseller (Görseller için 1 yıl)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fontlar
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # Veri ve XML
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>

# ==============================================================================
# Güvenlik Başlıkları (Security Headers)
# ==============================================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Tarayıcı önbelleği zorlama başlığı
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Dizin Listelemeyi Kapat
Options -Indexes
